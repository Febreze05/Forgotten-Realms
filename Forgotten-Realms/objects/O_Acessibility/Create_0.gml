// Camera controller - Create Event

zoom_level = 1.0;       // normal zoom
zoom_speed = 0.01;      // how fast zoom changes
min_zoom = 0.2;         // zoomed in (smaller = more zoomed in)
max_zoom = 1.0;         // zoomed out (larger = more zoomed out)

// Assign camera (first camera in view)
cam = view_camera[0];

// Store base room dimensions
base_width = 1366;
base_height = 768; // assign first camera

Font_level = 1.0;

